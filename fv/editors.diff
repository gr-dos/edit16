                                  Helpers
 ****************************************************************************}
 
+{ edit16: CountLines and GetLimits in assembler.  The Pascal loops took  }
+{ about 15 instructions a byte: 3 seconds on an XT to count the lines   }
+{ of a 60 KB file, for Ctrl+End, Ctrl+Home or loading it.  The results  }
+{ are the same: a CR LF or LF CR pair is one line break, and lim.x is   }
+{ the longest line in bytes.  (The Pascal GetLimits also went past the  }
+{ end of Buf when it ended in such a pair.)                             }
+
+{ The line breaks in Count bytes at Buf; the longest line in Max. }
+function ScanLines(var Buf; Count: sw_Word; var Max: sw_Word): sw_Word; assembler;
+asm
+  push ds
+  push si
+  push di
+  mov cx, Count
+  xor bx, bx            { the current line's length }
+  xor dx, dx            { line breaks }
+  xor di, di            { the longest line }
+  jcxz @done
+  lds si, Buf
+  cld
+@next:                  { most bytes: one compare }
+  lodsb
+  cmp al, 13
+  jbe @low
+  inc bx
+  loop @next
+  jmp @done
+@low:
+  je @brk
+  cmp al, 10
+  je @brk
+  inc bx
+  loop @next
+  jmp @done
+@brk:
+  dec cx
+  cmp bx, di
+  jbe @nomax
+  mov di, bx
+@nomax:
+  xor bx, bx
+  inc dx
+  jcxz @done
+  mov ah, [si]
+  add ah, al
+  cmp ah, 23            { CR LF or LF CR }
+  jne @next
+  inc si
+  dec cx
+  jcxz @done
+  jmp @next
+@done:
+  mov ax, di
+  les di, Max
+  mov es:[di], ax
+  mov ax, dx
+  pop di
+  pop si
+  pop ds
+end;
+
+
